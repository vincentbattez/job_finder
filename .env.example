# Copy to .env (out of git) and fill in: jf, the front and the worker read it at launch. Only a fallback
# for a Candidat whose Connexion Home Assistant has no address or token in the database (ADR-0006).
# Home Assistant, reachable from this machine
HOME_ASSISTANT_URL=http://homeassistant.local:8123
# A long-lived access token: Home Assistant, your profile, Security tab
HOME_ASSISTANT_TOKEN=
