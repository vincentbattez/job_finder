generator client {
  provider            = "prisma-client"
  output              = "../src/workspace/generated"
  // Node runs the generated TypeScript as is, without a build
  importFileExtension = "ts"
  // The Versions of a Posting, without an Interview, are numbered under a unique index of their own
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "sqlite"
}

// Candidates, their Watches and the Default Deadline Period are written from the front: the database
// is their source of truth (ADR-0011). A Candidate is never deleted, so the rows tied to them stay.
model Candidate {
  id                  String               @id
  name                String
  // The language of the interface, French unless the config of the first launch names another
  locale              Locale               @default(fr)
  watchList           Watch[]
  postingList         Posting[]
  notificationChannel NotificationChannel?
  jobList             Job[]
}

enum Locale {
  fr
  en
}

// The Default Deadline Period every Candidate shares, in a single row. Created at the first launch,
// from the data/config.json an older jf read when one is left, imported once and never read again
// (ADR-0011).
model DefaultDeadlinePeriod {
  id     Int @id
  // In months
  months Int
}

// The Notification Channel a Candidate chose, saved from the front. Its Parameters are those of its
// module, parsed by the module's schema (ADR-0010); a secret one is write-only, no action returns it
// (ADR-0006).
model NotificationChannel {
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String    @id
  module      String
  parameters  Json
}

model Watch {
  id          String    @id
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  candidateId String
  // The Source the Watch follows, and its Parameters: they are those of the
  // Source, parsed by the Source's schema (ADR-0010)
  source      String
  parameters  Json
  // When a Detection of this Watch last went through; null during its first launch, which may take
  // several Detections when one is cut off
  detectedAt  DateTime?
}

model Posting {
  id               Int           @id @default(autoincrement())
  candidate        Candidate     @relation(fields: [candidateId], references: [id])
  candidateId      String
  source           String
  reference        String
  title            String
  url              String?
  publishedAt      DateTime?
  deadline         DateTime?
  // The day its Position is to be filled, when its Job Description says so
  startDate        DateTime?
  employer         String?
  workplace        String?
  city             String?
  region           String?
  latitude         Float?
  longitude        Float?
  applicationEmail String?
  contact1         String?
  contact2         String?
  status           PostingStatus @default(to_apply)
  // When the Posting was first marked Applied: its Chosen Letter, the one sent, stays frozen even
  // once it is Archived
  appliedAt        DateTime?
  // When its stored Status last changed, null if never: it sorts the Applications
  statusChangedAt  DateTime?
  // When the Candidate archived it, null while they follow it: a mark beside the Status, which
  // unarchiving leaves as it was (ADR-0007)
  archivedAt       DateTime?
  // When a Detection found its Source no longer publishes it, null while online: a mark beside the
  // Status, which the Detection removes once the Source publishes it again (ADR-0001)
  unpublishedAt    DateTime?
  // Free Markdown the Candidate keeps on it, whatever its Status, and rewrites at will
  notes            String        @default("")
  repostOf         Posting?      @relation("Repost", fields: [repostOfId], references: [id])
  repostOfId       Int?
  repostList       Posting[]     @relation("Repost")
  detectedAt       DateTime      @default(now())
  versionList      Version[]
  jobList          Job[]
  interviewList    Interview[]

  @@unique([candidateId, source, reference])
}

// An Interview of an Application, one per round, numbered per Posting like a Version. Only a Posting
// that has an Application gets one; the Status reads them to show Invited or Interviewed (ADR-0009).
model Interview {
  id                  Int               @id @default(autoincrement())
  posting             Posting           @relation(fields: [postingId], references: [id])
  postingId           Int
  number              Int
  startAt             DateTime
  durationMinutes     Int               @default(60)
  // Free text, prefilled by the front with the place of work and the City of the Posting
  place               String
  // Free text: name, role, anything the Candidate knows of them
  interviewers        String
  // Grows at each edit: the SEQUENCE of its iCal event, so a calendar updates the event
  editCount           Int               @default(0)
  // Its Artifacts, and the jobs that make them: deleted with it
  versionList         Version[]
  jobList             Job[]
  // The Candidate's Revision of it, section by section: deleted with it
  revisionSectionList RevisionSection[]

  @@unique([postingId, number])
}

// A section of the Revision of an Interview (GLOSSARY.md « Revision »), keyed by its title rather than by a
// Version: the note and the Mastered mark follow a newer Chosen Interview Brief wherever the title remains
model RevisionSection {
  id          Int       @id @default(autoincrement())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewId Int
  title       String
  note        String    @default("")
  isMastered  Boolean   @default(false)

  @@unique([interviewId, title])
}

// Invited and Interviewed are computed from the Interviews, never stored (ADR-0009). A detected
// Posting starts New, an imported one To Apply (ADR-0018).
enum PostingStatus {
  new
  to_apply
  applied
  hired
  rejected
}

// A Version of the letter Artifact holds a pair: the Draft, never changed, and the Letter. The Versions
// of an Artifact attached to an Interview, such as the Interview Brief, are numbered and chosen per
// Interview; the others, such as the Research, per Posting, without an Interview.
model Version {
  id                       Int               @id @default(autoincrement())
  posting                  Posting           @relation(fields: [postingId], references: [id])
  postingId                Int
  interview                Interview?        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewId              Int?
  artifact                 Artifact
  number                   Int
  isChosen                 Boolean           @default(false)
  state                    VersionState
  // A Draft until the Candidate validates it, whoever produced it (ADR-0019)
  validation               VersionValidation @default(draft)
  // Produced by the AI, which keeps its Original, or brought by the Candidate, with none
  origin                   VersionOrigin     @default(ai)
  instructions             String
  // Whether those Instructions are the Candidate's own rather than the module's default ones
  hasCandidateInstructions Boolean           @default(false)
  // The Inputs its run read (ADR-0021)
  inputList                VersionInput[]    @relation("Input")
  readByList               VersionInput[]    @relation("ReadVersion")
  createdAt                DateTime          @default(now())
  // The job that produced this Version, so a job can be followed to its Version
  job                      Job?              @relation(fields: [jobId], references: [id])
  jobId                    Int?              @unique

  // SQLite tells two NULLs apart: the Versions of a Posting, without an Interview, need their own index
  @@unique([postingId, interviewId, artifact, number])
  @@unique([postingId, artifact, number], where: { interviewId: null })
}

// An Input a Version's run read, named by its key as the Artifact module resolves it: `job_description`,
// `notes`, `artifact:<artifact>[@<interview>]`, `posting:<reference>/<artifact>` or `profile:<file name>`.
// A read Version is linked too, so a record still tells which Version it was.
model VersionInput {
  id            Int      @id @default(autoincrement())
  version       Version  @relation("Input", fields: [versionId], references: [id], onDelete: Cascade)
  versionId     Int
  key           String
  readVersion   Version? @relation("ReadVersion", fields: [readVersionId], references: [id], onDelete: SetNull)
  readVersionId Int?

  @@unique([versionId, key])
}

enum Artifact {
  research
  letter
  portrait
  interview_brief
}

enum VersionState {
  running
  ready
  failed
}

enum VersionValidation {
  draft
  validated
}

enum VersionOrigin {
  ai
  candidate
}

// A job works on a Posting, or on the Profile of a Candidate: the conversion of one of its Uploads
model Job {
  id                    Int        @id @default(autoincrement())
  module                String
  posting               Posting?   @relation(fields: [postingId], references: [id], onDelete: Restrict)
  postingId             Int?
  // The Interview the job prepares, for a module attached to one
  interview             Interview? @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewId           Int?
  candidate             Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId           String?
  upload                String?
  state                 JobState   @default(queued)
  log                   String     @default("")
  // The code of the catalogue a failed job failed under, read by the front and the CLI (ADR-0015)
  errorCode             String?
  // Queued by the Detection or by an extraction, not by the Candidate: no one waits for it in front
  // of the screen, so its failure is notified
  isAutomatic           Boolean    @default(false)
  // The notification of the job that could not be sent: its code and its message, which the Posting
  // page shows, the job keeping its own state
  notificationErrorCode String?
  notificationFailure   String?
  sessionId             String?
  // The keys of the Inputs the Candidate checked for an Artifact job; null for the type's default Inputs
  inputKeyList          Json?
  // When the worker claimed it: past its maximum duration, a running job tells that the worker is stuck
  startedAt             DateTime?
  version               Version?
}

// The last sign of life of the worker, in a single row it touches while it runs: a queued or running
// job tells that no worker is running once the row is stale, or before the worker ever started
model WorkerHeartbeat {
  id     Int      @id
  beatAt DateTime
}

enum JobState {
  queued
  running
  done
  failed
}

// A Detection, recorded as soon as it is claimed: the front follows its steps and shows its verdict,
// whoever started it, and an unfinished one keeps a second one from running beside it (ADR-0014)
model Detection {
  id          Int              @id @default(autoincrement())
  origin      DetectionOrigin
  // The Candidate whose Watches it covers, null for every Watch
  candidateId String?
  startedAt   DateTime         @default(now())
  // Touched at each step: a Detection whose process died stops holding the lock once it is stale
  updatedAt   DateTime         @updatedAt
  // True while it runs, null once finished: the unique index lets a single Detection run at a time,
  // the front's and the daily one's alike
  runningLock Boolean?         @unique
  finishedAt  DateTime?
  // Why it stopped, in the locale of the Candidate whose Watch failed; the default one when its process died
  error       String?
  watchList   DetectionWatch[]
}

enum DetectionOrigin {
  button
  automation
  cli
}

// Where a Detection stands on one Watch, then what it found there. The Watch is copied, not linked:
// a Watch deleted since keeps its history.
model DetectionWatch {
  id                      Int           @id @default(autoincrement())
  detection               Detection     @relation(fields: [detectionId], references: [id], onDelete: Cascade)
  detectionId             Int
  watchId                 String
  candidateId             String
  // What the Candidate reads to tell the Watch apart, never its identifier
  label                   String
  step                    DetectionStep @default(waiting)
  isFirstLaunch           Boolean
  // How many Postings the Source listed for the Watch, once searched
  listedCount             Int?
  // The Job Descriptions read so far, out of those to read, once the Source is searched
  readCount               Int           @default(0)
  readTotal               Int?
  // The references and titles of the new Postings, saved as they are read so a failure tells them,
  // the near-miss ones, and the notifications not sent
  newPostingList          Json
  nearMissList            Json
  notificationFailureList Json
  // Why the Postings it saved stay without coordinates, API Géo being down: the next Detection locates them
  locationFailure         String?
}

enum DetectionStep {
  waiting
  searching
  reading
  notifying
  done
}
